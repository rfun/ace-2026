{
  "name": "ace-culture-cookbook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "build": "vite build",
    "preview": "vite preview",
    "check:dist": "node scripts/check-dist.mjs",
    "release": "npm run typecheck && npm test && npm run build && npm run check:dist"
  },
  "dependencies": {
    "heic-to": "1.6.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "4.1.12"
  }
}
